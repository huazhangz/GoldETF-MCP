{
  "name": "fred-timeseries-mcp",
  "version": "0.4.0",
  "description": "MCP server for FRED\u00ae economic data with statistically honest time-series tools for AI agents: stationarity, STL, ARIMA, GARCH, backtests vs a random walk, and cross-series correlation/Granger tests.",
  "mcpName": "io.github.huazhangz/fred-timeseries",
  "type": "module",
  "license": "MIT",
  "author": "Huazhang Zhou (https://github.com/huazhangz)",
  "homepage": "https://github.com/huazhangz/GoldETF-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huazhangz/GoldETF-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/huazhangz/GoldETF-MCP/issues"
  },
  "bin": {
    "fred-timeseries-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "fred",
    "economics",
    "time-series",
    "forecasting",
    "arima",
    "garch",
    "stationarity",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
