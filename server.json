{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.huazhangz/fred-timeseries",
  "description": "FRED economic data + honest time-series tools: stationarity, ARIMA/GARCH, backtests, correlation.",
  "repository": {
    "url": "https://github.com/huazhangz/GoldETF-MCP",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fred-timeseries-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Free FRED API key (https://fredaccount.stlouisfed.org/apikeys)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "FRED_API_KEY"
        }
      ]
    }
  ]
}
